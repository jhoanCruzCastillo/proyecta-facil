# Flags de datos falsos vs. reales, por recurso — 'true' usa el mock local (localStorage),
# 'false' llama al backend real de CodeIgniter en /api. Se migran uno por uno conforme el
# backend exponga cada endpoint (ver docs/database-design.md).
VITE_MOCK_SECTORES=true
VITE_MOCK_PLANTILLAS=true
VITE_MOCK_EJEMPLOS=true
VITE_MOCK_USUARIOS=true
VITE_MOCK_MENTORIAS=true
VITE_MOCK_FACTURACION=true
VITE_MOCK_HISTORIAL=true
VITE_MOCK_ACTIVIDAD=true
